// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  connectedAccounts ConnectedAccount[]
  scheduledPosts    ScheduledPost[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]

  @@index([workspaceId])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  dmMessage      String
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

// ─── Multi-platform content scheduler ────────────────────────────────────────
//
// One external publishing account (an IG professional account, a Facebook Page,
// a YouTube channel, a TikTok account). Distinct from InstagramAccount, which
// belongs to the comment→DM feature and carries messaging scopes: the two use
// different App Review tracks and are deliberately not merged.
model ConnectedAccount {
  id          String        @id @default(cuid())
  workspaceId String
  platform    SocialPlatform

  // Page ID / IG user ID / YouTube channel ID / TikTok open_id.
  platformAccountId String
  displayName       String
  avatarUrl         String?

  // AES-256-GCM, base64 (iv|authTag|ciphertext) — same cipher and key as
  // InstagramAccount.accessToken. Never stored or logged in plaintext.
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?

  // What the platform actually granted, not what we asked for.
  scopes String[]

  // Platform-specific state that has no schema of its own: IG account type,
  // YouTube channel thumbnail, Page category, TikTok post mode + creator limits.
  metadata Json?

  status ConnectedAccountStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scheduledPosts ScheduledPost[]
  quotaUsage     PlatformQuotaUsage[]

  // The same external account cannot be linked twice, but a workspace may link
  // unlimited distinct accounts per platform.
  @@unique([workspaceId, platform, platformAccountId])
  @@index([workspaceId])
  @@index([status])
}

model ScheduledPost {
  id                 String @id @default(cuid())
  // Denormalised so the calendar can query a workspace's posts without a join,
  // matching DmLog and LinkClick.
  workspaceId        String
  connectedAccountId String

  // The shape of the POST, not of any one file: REEL, IMAGE, CAROUSEL, …
  // A carousel is one post with many `media` rows. The files themselves live
  // in the `media` relation below — this model holds no storage key of its own.
  mediaType ScheduledPostMediaType
  caption   String                 @default("")

  // Per-platform options that only one platform understands: TikTok
  // privacy_level and interaction toggles, YouTube title/categoryId,
  // IG share_to_feed, FB Reels vs feed. Validated per platform at creation.
  platformOptions Json?

  scheduledAt DateTime
  status      ScheduledPostStatus @default(QUEUED)

  // Populated after a successful publish / native schedule.
  platformPostId      String?
  // IG container ID, TikTok publish_id, YouTube video ID, FB video ID — the
  // handle used to poll status.
  platformContainerId String?

  lastError    String?
  attemptCount Int       @default(0)
  publishedAt  DateTime?

  // One composer submission fanning out to N accounts shares a batch, so the
  // UI can group "this video, 4 accounts" as a single card.
  batchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount     @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  jobLogs          PublishJobLog[]
  media            ScheduledPostMedia[]

  // Exactly the fire-time poll's predicate.
  @@index([status, scheduledAt])
  @@index([workspaceId, scheduledAt])
  @@index([connectedAccountId])
  @@index([batchId])
}

/// One file in a post, in carousel order.
///
/// Single-media posts — every post before 2026-08-08 — have exactly one row at
/// position 0. Instagram carousels have 2–10. This is a child table rather than
/// a JSON column because `position` needs a uniqueness constraint and the probe
/// data below needs to be queryable: a JSON blob would let two items claim the
/// same slot and leave "which posts did we crop?" unanswerable.
model ScheduledPostMedia {
  id              String @id @default(cuid())
  scheduledPostId String

  // 0-based. Contiguous, and the order the platform is told to render.
  position   Int
  storageKey String
  mimeType   String
  sizeBytes  BigInt
  kind       ScheduledPostMediaKind

  // Probed in the browser at selection time — nothing server-side ever opens
  // the file. Null means probing failed; treat as unknown, never as invalid.
  // Instagram rejects images outside 4:5–1.91:1 rather than cropping them,
  // which is the only reason we care about dimensions at all.
  widthPx    Int?
  heightPx   Int?
  durationMs Int?

  /// Set only when the user accepted a crop, e.g. "4:5". Null means this is the
  /// untouched original — the default, and the only path that never re-encodes.
  croppedToRatio String?

  createdAt DateTime @default(now())

  post ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)

  // Two items cannot occupy the same carousel slot.
  @@unique([scheduledPostId, position])
  @@index([scheduledPostId])
}

// Append-only audit trail. responseSnippet is truncated and scrubbed before
// write — platform errors echo request context and must never carry a token.
model PublishJobLog {
  id              String   @id @default(cuid())
  scheduledPostId String
  attempt         Int
  status          String
  responseSnippet String?
  createdAt       DateTime @default(now())

  scheduledPost ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)

  @@index([scheduledPostId])
  @@index([createdAt])
}

// Daily counters we must track ourselves because the platform gives us no
// pre-flight endpoint. YouTube rows are project-wide (connectedAccountId null,
// 1600 units per upload against a 10,000/day default); TikTok and Facebook
// Reels rows are per-account post counts.
model PlatformQuotaUsage {
  id                 String         @id @default(cuid())
  platform           SocialPlatform
  connectedAccountId String?
  // UTC date bucket (midnight-normalised).
  date               DateTime
  unitsUsed          Int            @default(0)
  postsCount         Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectedAccount ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([platform, connectedAccountId, date])
  @@index([platform, date])
}

enum SocialPlatform {
  FACEBOOK_PAGE
  INSTAGRAM
  YOUTUBE
  TIKTOK
}

enum ConnectedAccountStatus {
  ACTIVE
  // Refresh failed permanently (Google invalid_grant, TikTok auth_removed,
  // Meta code 190). A first-class state, not an error string.
  NEEDS_REAUTH
  DISABLED
}

/// The shape of a post, not the type of any one file. IMAGE and CAROUSEL are
/// Instagram feed posts; the rest are single-video posts.
enum ScheduledPostMediaType {
  REEL
  IMAGE
  CAROUSEL
  SHORT
  TIKTOK_VIDEO
  FACEBOOK_REEL
  FACEBOOK_VIDEO
}

/// What a single ScheduledPostMedia row holds. Derived server-side from the
/// stored content type — never taken from the client.
enum ScheduledPostMediaKind {
  IMAGE
  VIDEO
}

enum ScheduledPostStatus {
  QUEUED
  UPLOADING
  PUBLISHING
  // Natively scheduled by the platform (YouTube publishAt, FB
  // scheduled_publish_time). Upload is done; the platform holds the timer.
  SCHEDULED_REMOTE
  PUBLISHED
  FAILED
  CANCELED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}
