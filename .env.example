# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
# Optional. Direct/session connection used ONLY for `prisma migrate deploy`.
# Leave unset for a direct DATABASE_URL (e.g. local Postgres). On Supabase set
# this to the "Session pooler" URI (port 5432) — the transaction pooler
# (port 6543) makes migrations hang on the advisory lock. The app runtime keeps
# using DATABASE_URL (the transaction pooler is correct there).
# DIRECT_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379

# Auth: password sign-in only. Accounts are provisioned by an admin
# (see scripts/make-user-sql.mjs) — there is no self-service registration.

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# One Instagram authorization for BOTH comment→DM and scheduled publishing.
# On by default. Set to 0 only if strangers connect their own accounts to this
# instance AND instagram_business_content_publish is not yet approved with
# Advanced Access — a consent screen containing an unapproved permission fails
# entirely for non-tester users, which would break comment→DM too. With it off,
# publishing is connected separately on the Connections page.
# Either way, users can force a messaging-only connect with
# /api/instagram/connect?publish=0
# IG_UNIFIED_CONNECT=1

# ─── Multi-platform scheduler ────────────────────────────────────────────────
# Only needed for the platforms you actually connect. Each is optional; a
# platform with no credentials simply cannot be connected.

# Where ORIGINAL video files are stored. MUST be outside the deploy directory:
# the deploy workflow rsyncs with --delete, so media under the app root is
# erased on the next deploy. Must be writable by the PM2 user.
MEDIA_STORAGE_DIR=/var/lib/openreply/media
# Hard ceiling per upload (bytes). Default 2 GB.
# MEDIA_MAX_UPLOAD_BYTES=2147483648

# Facebook Pages (same Meta app as Instagram; needs pages_show_list,
# pages_read_engagement, pages_manage_posts + App Review).
# FACEBOOK_APP_ID is also required for the resumable video upload session.
FACEBOOK_APP_ID=your-facebook-app-id

# YouTube (Google Cloud project + OAuth client).
# NOTE: until the project passes YouTube's API audit every upload is forced
# private, and while the consent screen is in "Testing" refresh tokens expire
# after 7 days.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# videos.insert costs 1600 units; the default project quota is 10000/day
# (~6 uploads/day). Raise only after Google grants an extension.
# YOUTUBE_DAILY_QUOTA_UNITS=10000

# TikTok (Login Kit + Content Posting API v2).
# Unaudited apps can only post privately (SELF_ONLY), so connected accounts
# default to inbox delivery instead.
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# How often the worker looks for scheduled posts that are due (ms).
# PUBLISH_POLL_INTERVAL_MS=60000

# Adds the `video.publish` scope so TikTok accounts can use Direct Post instead
# of inbox delivery, and makes newly connected accounts default to Direct Post.
# Leave unset until TikTok has APPROVED video.publish for your app — TikTok
# rejects an authorize call containing an unapproved scope, so turning this on
# early breaks connecting entirely.
#
# Note that "app is live" is NOT this approval: going live with the Content
# Posting API grants video.upload (inbox delivery only). video.publish is a
# separate audit — check the developer console before setting this.
#
# Scopes are baked into the token at authorize time, so accounts connected
# BEFORE this was set must be disconnected and reconnected. Set it in both the
# web app and the worker, and restart both (`pm2 restart <app> --update-env`,
# which is required — pm2 reuses the cached environment otherwise).
# TIKTOK_ENABLE_DIRECT_POST=true

# Whether TikTok has audited this app for Direct Post.
#
# A THIRD approval, separate from both "app is live" and video.publish above,
# and applied for separately at:
#   https://developers.tiktok.com/application/content-posting-api
# An app can be fully in production, with production credentials, and still be
# "unaudited" — the audit is not part of going live.
#
# While unaudited, TikTok imposes TWO restrictions on Direct Post:
#   1. the CREATOR'S ACCOUNT must be set to private at the time of posting
#      (this is what `unaudited_client_can_only_post_to_private_accounts`
#      means — the account, not the post; "Only me" does not satisfy it), and
#   2. content may only be posted with SELF_ONLY viewership.
# It also caps an unaudited client at 5 posting users per 24 hours.
#
# So for a PUBLIC account, inbox delivery is the only path that works — it
# carries none of these restrictions and posts publicly from the TikTok app.
#
# Leave unset unless the audit has actually passed. Restart the web app AND
# the worker after changing it.
# TIKTOK_CONTENT_POSTING_AUDITED=true
